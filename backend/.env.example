# Copia este archivo como .env y rellena los valores.
# Los datos salen del panel de Supabase: Settings > Data API y Settings > API Keys.

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...
YOUTUBE_API_KEY=

# Opcional: sin esta llave la app funciona, solo se apaga la capa de IA.
# Se saca de console.anthropic.com
ANTHROPIC_API_KEY=

FRONTEND_ORIGINS=